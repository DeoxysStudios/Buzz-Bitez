@url = http://127.0.0.1:8000

### List users
GET {{url}}/users

### Get one user
GET {{url}}/users/test_user

### Create a user (password is hashed before storage, never returned)
POST {{url}}/users
Content-Type: application/json

{
    "username": "test_user",
    "email": "john_doe@rpi.edu",
    "password": "password123"
}

### Delete a user (409 if they still have reported events)
DELETE {{url}}/users/test_user

### List events (newest first)
GET {{url}}/events

### Get one event (paste an event_id from a POST response)
GET {{url}}/events/0bdda61a-edd9-49de-a4a4-96aaa5b31f09

### Create an event (event_id is generated by the server; times need a timezone offset)
POST {{url}}/events
Content-Type: application/json

{
    "name": "APO",
    "reporter": "test_user",
    "location": "Student Union",
    "times": [ ["2026-09-29T13:00:00-04:00", "2026-09-29T15:00:00-04:00"], ["2026-09-29T16:00:00-04:00", "2026-09-29T17:30:00-04:00"] ],
    "description": "I dunno anything about this event, but pretend that I do and put the info here.",
    "tags": ["vegetarian", "pizza", "ice cream"]
}

### Update an event (replaces name, location, times, description, and tags)
PUT {{url}}/events/0bdda61a-edd9-49de-a4a4-96aaa5b31f09
Content-Type: application/json

{
    "name": "APO (moved)",
    "location": "DCC 308",
    "times": [ ["2026-09-29T14:00:00-04:00", "2026-09-29T16:00:00-04:00"] ],
    "description": "Moved upstairs.",
    "tags": ["pizza"]
}

### Delete an event (its times, tags, and likes go with it)
DELETE {{url}}/events/0bdda61a-edd9-49de-a4a4-96aaa5b31f09

### Like an event (liking twice is fine)
POST {{url}}/events/0bdda61a-edd9-49de-a4a4-96aaa5b31f09/likes
Content-Type: application/json

{
    "username": "test_user"
}

### Remove a like
DELETE {{url}}/events/0bdda61a-edd9-49de-a4a4-96aaa5b31f09/likes/test_user
